{
  "name": "bos-strength",
  "version": "0.0.1",
  "description": "BOS STRENGTH parametric rack and equipment models",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "tsx --test rack-generator/*.test.ts src/**/*.test.ts",
    "test:logos:browser": "playwright test e2e/logos.spec.ts --workers=1"
  },
  "keywords": [],
  "author": "Wes Bos (https://wesbos.com/)",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@tanstack/react-router": "^1.170.38",
    "@xmldom/xmldom": "^0.9.12",
    "manifold-3d": "^3.5.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "draco3dgltf": "^1.5.7",
    "esbuild-wasm": "^0.27.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "wrangler": "^4.134.0"
  }
}
